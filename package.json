{
  "name": "hands-on-jev",
  "private": true,
  "version": "1.0.0",
  "description": "Two Truths and a Lie vs Jev — a real-time party game that puts TypeSafe's Jev model in the hot seat.",
  "type": "module",
  "scripts": {
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vite": "^8.3.0"
  }
}
